# 1. break statement
print("Example of break statement:")
for i in range(1, 10):
    if i == 5:
        break
    print(i)

# 2. continue statement
print("\nExample of continue statement:")
for i in range(1, 10):
    if i == 5:
        continue
    print(i)

# 3. pass statement
print("\nExample of pass statement:")
for i in range(1, 10):
    if i == 5:
        pass
    print(i)
